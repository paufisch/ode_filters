# Shared matplotlib style for the ode_filters documentation notebooks.
# Loaded with `plt.style.use("ode_filters.mplstyle")` so the notebook import
# cells stay free of plotting boilerplate.
figure.dpi: 120
savefig.dpi: 120
savefig.bbox: tight
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.alpha: 0.3
grid.linewidth: 0.6
axes.axisbelow: True
lines.linewidth: 2.0
legend.frameon: False
font.size: 11
axes.titlesize: 12
axes.labelsize: 11
